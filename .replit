modules = ["nodejs-22"]

run = "corepack pnpm@10.33.0 install --frozen-lockfile && corepack pnpm@10.33.0 preview"

[env]
COREPACK_ENABLE_DOWNLOAD_PROMPT = "0"
COREPACK_ENABLE_AUTO_PIN = "0"
BLOOMFIRE_LOGIN_EMAIL = "matthew.kramer@wildflowerschools.org"
STAFF_DOMAIN = "wildflowerschools.org"
MAIL_FROM = "Wildflower Wisdom <wisdom@wildflowerschools.org>"

[packager]
language = "nodejs"

[packager.features]
enabledForHosting = false
packageSearch = false
guessImports = false

[deployment]
run = ["sh", "-c", "COREPACK_ENABLE_DOWNLOAD_PROMPT=0 COREPACK_ENABLE_AUTO_PIN=0 corepack pnpm@10.33.0 deploy:start"]
build = ["sh", "-c", "COREPACK_ENABLE_DOWNLOAD_PROMPT=0 COREPACK_ENABLE_AUTO_PIN=0 corepack pnpm@10.33.0 deploy:build"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "corepack pnpm@10.33.0 install --frozen-lockfile && corepack pnpm@10.33.0 preview"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[nix]
channel = "stable-25_05"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000
