modules = ["nodejs-22"]

run = "corepack pnpm@10.33.0 install --frozen-lockfile && corepack pnpm@10.33.0 preview"

[deployment]
run = ["corepack", "pnpm@10.33.0", "deploy:start"]
build = ["corepack", "pnpm@10.33.0", "deploy:build"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "corepack pnpm@10.33.0 install --frozen-lockfile && corepack pnpm@10.33.0 preview"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[nix]
channel = "stable-25_05"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000
